{
  "name": "jofoundry",
  "version": "0.5.0",
  "description": "Local multi-model research workspace for staged evidence review, resumable goals, and bilingual manuscripts",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "bin": {
    "foundry": "./lib/cli.mjs",
    "jofoundry": "./lib/cli.mjs"
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "scripts": {
    "probe": "node lib/cli.mjs probe",
    "mock": "FOUNDRY_MOCK=1 node lib/cli.mjs run --topic \"测试主题\"",
    "start": "node lib/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:privacy": "node scripts/check-privacy.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc <2",
    "cordis": ">=4.0.0-rc <5"
  },
  "dsh": {
    "plugin": {
      "id": "research-foundry",
      "displayName": "JoFoundry",
      "description": "可配置模型与角色的科研协作：派工、互审、综合与长期记忆"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "cordis": {
      "optional": true
    }
  }
}
